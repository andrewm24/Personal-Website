rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    function isValidEmail(value) {
      return value is string
        && value.size() <= 120
        && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    match /contactSubmissions/{submissionId} {
      allow read, update, delete: if false;
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'organization',
          'projectType',
          'message',
          'source',
          'submittedAt'
        ])
        && isShortString(request.resource.data.name, 80)
        && isValidEmail(request.resource.data.email)
        && isShortString(request.resource.data.organization, 120)
        && isShortString(request.resource.data.projectType, 40)
        && isShortString(request.resource.data.message, 1500)
        && isShortString(request.resource.data.source, 300)
        && request.resource.data.submittedAt is timestamp;
    }
  }
}
